<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debuggable builds only: trust user-installed CAs so a local HTTPS IdP can be used. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
